{
  "name": "teenaitook",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"@teenaitook/*\" dev",
    "build": "pnpm --filter @teenaitook/api db:generate && pnpm -r build",
    "lint": "oxlint --deny-warnings apps scripts && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter @teenaitook/api db:generate && pnpm -r typecheck",
    "test": "pnpm --filter @teenaitook/api test",
    "test:e2e": "pnpm --filter @teenaitook/api test:e2e",
    "test:web": "pnpm --filter @teenaitook/web test",
    "db:generate": "pnpm --filter @teenaitook/api db:generate",
    "db:migrate": "pnpm --filter @teenaitook/api db:migrate",
    "db:seed": "pnpm --filter @teenaitook/api db:seed",
    "db:studio": "pnpm --filter @teenaitook/api db:studio",
    "db:reset": "pnpm --filter @teenaitook/api db:reset",
    "setup:env": "node scripts/setup-env.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "oxlint": "1.81.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
